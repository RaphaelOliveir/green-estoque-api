generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum ItemStatus {
  EM_ESTOQUE
  INSTALADO
}

enum ProductType {
  SOLAR_PANEL
  INVERTER
  STRUCTURE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  @@map("users")
}



model Product {
  id             String      @id @default(uuid())
  name           String
  vendor         String
  customer       String?
  purchaseDate   DateTime    @map("purchase_date")
  entryStockDate DateTime    @default(now()) @updatedAt @map("entry_stock_date")
  cost           Decimal     @db.Decimal(10, 2)
  type           ProductType
  description    String?
  image          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@map("products")
}

model InventoryMovement {
  id           String     @id @default(uuid())
  productId    String     @map("product_id")
  status       ItemStatus @default(EM_ESTOQUE)
  observations String?
  // Copied product fields (excluding code)
  name         String?
  vendor       String?
  customer     String?
  purchaseDate DateTime?
  entryStockDate DateTime?
  cost         Decimal?
  type         ProductType?
  description  String?
  image        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory_movements")
}
