# Green Estoque — Backend API
# Copie este arquivo para .env e preencha com seus valores reais

# Servidor
PORT=3001
NODE_ENV=development

# Frontend (para configuração do CORS)
FRONTEND_URL=http://localhost:5173

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=green_estoque
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# JWT
JWT_SECRET=seu_segredo_jwt_aqui_min_32_chars
JWT_EXPIRES_IN=7d

# Admin inicial (seed automático)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@greenestoque.com
ADMIN_SENHA=Admin@123456

# E-mail (Nodemailer via Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_app_password_gmail
EMAIL_FROM="Green Estoque <seu_email@gmail.com>"

# URL do backend (para links nos e-mails)
API_URL=http://localhost:3001
